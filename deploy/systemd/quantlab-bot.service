# Install (as root), assuming the repo lives in /opt/quant-lab with its .venv and .env:
#   cp deploy/systemd/quantlab-bot.* /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now quantlab-bot.timer
#   systemctl list-timers quantlab-bot.timer      # next run
#   journalctl -u quantlab-bot / tail logs/bot.log
[Unit]
Description=quant-lab paper-trading bot (one step)
Wants=network-online.target
After=network-online.target mysql.service

[Service]
Type=oneshot
User=quantlab
WorkingDirectory=/opt/quant-lab
Environment=XDG_CACHE_HOME=/opt/quant-lab/.cache
Environment=BOT_NAME=sp500-pairs
ExecStart=/bin/bash /opt/quant-lab/deploy/run_bot.sh
TimeoutStartSec=30min
# Hardening (same as the API): the bot only writes its cache and logs. Keeping the checkout
# read-only also stops a compromised bot from editing deploy/ files that update.sh runs as root.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/quant-lab/.cache /opt/quant-lab/logs
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryHigh=1200M
MemoryMax=1800M
TasksMax=256
