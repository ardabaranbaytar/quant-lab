# Copy to .env and fill in. .env is git-ignored.
MYSQL_USER=root
MYSQL_PASSWORD=your_secure_password_here
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=quantlab
# Optional: lets the History page delete saved backtests (needs 24+ random characters, e.g. `openssl rand -hex 24`).
# Leave it out and nobody can delete anything.
# QUANTLAB_ADMIN_TOKEN=
